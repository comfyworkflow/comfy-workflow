# Defaults: let Git decide based on content
* text=auto

# Source code and configs: force LF (Unix-friendly, modern standard)
*.py text eol=lf
*.md text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.txt text eol=lf
*.gitignore text eol=lf
*.gitattributes text eol=lf

# Windows-native scripts: preserve CRLF physically in the blob so
# raw.githubusercontent.com serves bytes verbatim with CRLF intact.
# Audiência baixa via "Download raw file" do GitHub e roda direto em
# cmd.exe; cmd.exe falha silenciosamente parsear labels e blocos
# multi-line se as quebras de linha forem LF only (`text eol=crlf`
# normaliza blob pra LF e converte só no checkout, então raw download
# entrega LF — bug confirmado live cg-5090 2026-05-14).
#
# `-text` (binary treatment) preserves on-disk bytes without any
# filter conversion. Diff readability stays fine since git renders
# these as text in the UI — `binary` keyword would suppress diffs.
*.bat -text
*.cmd -text
*.ps1 -text

# Binary: never normalize, mark explicitly to avoid corruption
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.safetensors binary
*.ckpt binary
*.pt binary
*.bin binary
*.gguf binary
*.7z binary
*.zip binary
