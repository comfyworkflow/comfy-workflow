# === Project-specific: viewer outputs ===

# When viewer runs --benchmark, JSONs are written to ./results/ by default
# Public repo does NOT commit results (each viewer has their own)
results/

# Generated images
**/*.png
**/*.jpg
**/*.jpeg
**/*.webp

# But keep images in workflows/ (those are just ComfyUI workflow JSONs)
!workflows/**/*.png
!docs/images/*.png

# Dry-run output artifacts (PNGs + summary.json per timestamp)
dry_run_outputs/

# Runner output artifacts (PNGs + summary.json per timestamp)
runner_outputs/

# Partial download files
**/*.part

# Installer logs
installer.log
installation_report*.txt

# === Downloaded models (NEVER commit — manifest defines where to download) ===
models/
*.safetensors
*.ckpt
*.pt
*.bin
*.gguf

# === ComfyUI Portable (installed by viewer separately) ===
ComfyUI_windows_portable/

# === Credentials ===
.env
.env.*
!.env.example
*.token
hf_token.txt
